# Prowl Range 环境变量样例
# 复制为 .env 并按部署环境修改。

# Database
DB_PASSWORD=prowl_secret
DATABASE_URL=postgres://prowl:prowl_secret@localhost:5432/prowl?sslmode=disable

# Redis
REDIS_URL=localhost:6379
REDIS_PASSWORD=

# Server
LISTEN_ADDR=:38080
GIN_MODE=release
JWT_SECRET=change-this-to-a-long-random-secret
UPLOAD_DIR=./uploads
GRPC_ADDR=:39091
CORS_ALLOWED_ORIGINS=
DB_MIGRATION_MODE=auto
OUTBOUND_HTTP_TIMEOUT=15s

# OAuth (optional)
OAUTH_ENABLED=
OAUTH_PROVIDER=
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=
OAUTH_REDIRECT_URL=
OAUTH_AUTH_URL=
OAUTH_TOKEN_URL=
OAUTH_USERINFO_URL=

# Challenge containers
DOCKER_HOST=unix:///var/run/docker.sock
MAX_CONTAINERS_TOTAL=500
MAX_CONTAINERS_PER_TEAM=5
CONTAINER_NETWORK_PREFIX=range
CHALLENGE_BASE_URL=http://localhost
FLAG_SECRET_KEY=change-this-flag-secret

# Frontend
VITE_API_URL=http://localhost:38080
# VITE_WS_URL is auto-derived from VITE_API_URL (http->ws, https->wss)

# Build metadata
VERSION=dev
GIT_COMMIT=unknown
