# Prowl Range - Docker 环境变量
# 复制为 .env 并修改

# 数据库密码
DB_PASSWORD=prowl_secret

# JWT 密钥（必填，生产环境务必改成强随机字符串）
JWT_SECRET=

# Gin 模式: debug / release
GIN_MODE=release

# 数据库迁移模式: auto（自动建表） / validate（仅校验）
# 首次部署必须用 auto，后续可改为 validate
DB_MIGRATION_MODE=auto

# 构建信息（CI/CD 自动填入）
VERSION=dev
GIT_COMMIT=unknown
